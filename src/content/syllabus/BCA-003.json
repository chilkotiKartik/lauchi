        "state diagrams",
        "state tables",
        "state reduction methods (implication table)",
        "state assignment",
        "hazards in combinational/sequential circuits (static-0, static-1, dynamic hazards)",
        "essential hazards",
        "race-free state assignment in asynchronous machines"
      ],
      "formulas": [],
      "hints": [
        "Define critical and non-critical races in asynchronous sequential circuits",
        "Define a Hazard"
      ]
