# Public (safe for the browser). Create a Supabase project, then copy these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your deployed site URL, used in sign-in emails (e.g. https://lockin.example.com)
NEXT_PUBLIC_SITE_URL=
# Set to true only after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_ENABLED=false
# Shown on the legal pages (DPDP requires a grievance contact)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_EMAIL=

# Server only. Never prefix with NEXT_PUBLIC_ and never commit real values.
# Supabase dashboard > Project Settings > API Keys > service_role. Needed for quizzes, XP and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional: questions each student may ask Lochi per day (default 30), and the Gemini model to use
AI_DAILY_LIMIT=30
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. In-app video lectures (YouTube Data API v3). Free key from console.cloud.google.com → APIs → YouTube Data API v3.
# Without it, video buttons fall back to opening a YouTube search in a new tab. Search results are cached for a day.
YOUTUBE_API_KEY=

# Photo check (paper simulator / answer scan). Optional; defaults shown.
GEMINI_VISION_MODEL=
CHECK_DAILY_LIMIT=10

# Push notifications (study reminders). Generate keys once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string. Your scheduler calls /api/cron/reminders with "Authorization: Bearer <this>"
CRON_SECRET=

# Optional comma-separated emails that get the Admin panel automatically (otherwise insert into public.admins)
ADMIN_EMAILS=
